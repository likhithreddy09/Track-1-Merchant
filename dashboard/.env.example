# Get a key at https://www.sarvam.ai — used by Vite proxy only
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional — enables original Google ratings + review text for nearby rivals
# Enable Places API on Google Cloud, then paste the key here and restart `npm run dev`
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
